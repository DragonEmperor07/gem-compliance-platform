---
import AppLayout from '../../layouts/AppLayout.astro';
import { portals } from '../../data/mock';

const base = import.meta.env.BASE_URL;

const glyphs: Record<string, string> = {
  gst: '<path d="M8.5 6.5h7M8.5 10h7M14.6 6.5c0 3.5-2.6 3.5-6.1 3.5l7 7.5"/>',
  ban: '<circle cx="12" cy="12" r="8.4"/><path d="m6.6 6.6 10.8 10.8"/>',
};

const degraded = portals.filter((p) => p.status !== 'ok');
const live = portals.filter((p) => p.status === 'ok');

/* median response, computed rather than asserted */
const secs = portals
  .map((p) => parseFloat(p.latency) * (p.latency.includes('ms') ? 0.001 : 1))
  .sort((a, b) => a - b);
const mid = secs.length % 2
  ? secs[(secs.length - 1) / 2]
  : (secs[secs.length / 2 - 1] + secs[secs.length / 2]) / 2;
const median = mid < 1 ? `${Math.round(mid * 1000)} ms` : `${mid.toFixed(1)} s`;

const tabs = [
  { key: 'all', label: 'All sources', n: portals.length },
  { key: 'ok', label: 'Live', n: live.length },
  { key: 'degraded', label: 'Degraded', n: degraded.length },
];
---

<AppLayout title="Portal status — Pramaan console" active="portals" crumbs={[{ label: 'Portal status' }]}>
  <div class="page-head">
    <div>
      <h1>Source integrations</h1>
      <div class="meta-row">
        <span><b>{live.length}</b> of {portals.length} live</span>
        <span>1,026 calls today</span>
        <span>median <b>{median}</b></span>
        <span>last sweep 14:11</span>
      </div>
    </div>
    <div class="acts">
      <button class="btn-sm" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5A8 8 0 1 1 17.5 6"/><path d="M20 4v5h-5"/></svg>
        Re-test all
      </button>
    </div>
  </div>

  {degraded.length > 0 && (
    <div class="panel" style="margin-bottom:18px; border-color:rgba(180,97,28,.35);">
      <div class="panel-head" style="background:var(--flag-soft); border-bottom-color:rgba(180,97,28,.25);">
        <h2 style="display:flex; align-items:center; gap:9px;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--flag)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5M12 16.2v.1"/><circle cx="12" cy="12" r="9"/></svg>
          {degraded.length} {degraded.length === 1 ? 'source' : 'sources'} responding slowly
        </h2>
        <span class="note">Checks are queued, not failed</span>
      </div>
      <div class="panel-body" style="padding:10px 14px;">
        <span style="font-size:13px; color:var(--ink-soft);">
          {degraded.map((d) => `${d.name} at ${d.latency}, ${d.uptime} over 30 days, last answered ${d.last}`).join('; ')}.
          <b style="color:var(--ink);">2 checks pending</b> on
          <span class="mono-cell">GEM/2026/B/4471</span> — queued for retry, not failed.
        </span>
      </div>
    </div>
  )}

  <div class="tabs" data-ftabs="psrc" role="tablist" aria-label="Filter sources">
    {tabs.map((t, i) => (
      <button
        class={`tab${i === 0 ? ' on' : ''}`}
        type="button"
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-filter={t.key}
      >
        {t.label} <span class="n">{t.n}</span>
      </button>
    ))}
    <span class="mono-cell num" data-fcount="psrc" style="margin-left:auto; padding-left:14px;">0 rows</span>
  </div>

  <div class="toolbar" style="border:1px solid var(--line-strong); border-radius:var(--r-md); background:var(--surface); margin-bottom:14px;">
    <div class="inline-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      <input type="search" data-fsearch="psrc" placeholder="Source name…" aria-label="Filter sources" />
    </div>
    <button class="chipf" type="button" data-fchip="psrc" data-term="Consent">Consent-based</button>
    <button class="chipf" type="button" data-fchip="psrc" data-term="Batch">Batch</button>
  </div>

  <div class="pgrid" id="psrc" data-ftable>
    {portals.map((p) => (
      <div
        class="pcard"
        data-frow
        data-status={p.status}
        data-text={`${p.name} ${p.mode} ${p.status}`.toLowerCase()}
      >
        <div class="pcard-h">
          <span class="logo" aria-hidden="true">
            {p.file
              ? <img src={`${base}logos/${p.file}`} alt="" loading="lazy" decoding="async" />
              : <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink-muted)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[p.glyph ?? 'ban']}></svg>}
          </span>
          <span class="n">{p.name}</span>
          <span class={`pstat ${p.status}`}>
            <i aria-hidden="true"></i>
            {p.status === 'ok' ? 'Live' : 'Slow'}
          </span>
        </div>
        <div class="pmeta">
          <div>
            <div class="k">Response</div>
            <div class="v" style={p.status !== 'ok' ? 'color:var(--flag)' : ''}>{p.latency}</div>
          </div>
          <div>
            <div class="k">30-day</div>
            <div class="v">{p.uptime}</div>
          </div>
          <div>
            <div class="k">Access</div>
            <div class="v">{p.mode}</div>
          </div>
        </div>
        <div style="margin-top:12px; font-family:var(--mono); font-size:10.5px; color:var(--ink-muted);">
          Last successful call {p.last}
        </div>
      </div>
    ))}

    <div class="empty" data-fempty="psrc" style="grid-column:1 / -1;">
      <div class="t">No source matches that filter</div>
      <div class="d">Nothing in the integration list matches the current tab and search.</div>
      <button class="btn-sm" type="button" data-freset="psrc">Clear filters</button>
    </div>
  </div>

</AppLayout>
