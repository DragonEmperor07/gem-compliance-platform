---
import AppLayout from '../../layouts/AppLayout.astro';
import LiveAnalysis from '../../components/LiveAnalysis.astro';
import { tender, bidders } from '../../data/mock';

const base = import.meta.env.BASE_URL;
const cols = '30px minmax(0,1.45fr) 112px 84px 104px minmax(0,124px)';

/* Counts are counted, never typed. An earlier revision hard-coded them into a
   stat strip and the tabs, and both disagreed with the table underneath. */
const slug: Record<string, string> = {
  'Qualified': 'qualified',
  'Awaiting decision': 'awaiting',
  'In review': 'review',
  'Flagged': 'flagged',
};
const n = (k: string) => bidders.filter((b) => slug[b.status] === k).length;
const avg = Math.round(bidders.reduce((t, b) => t + b.score, 0) / bidders.length);
const riskRank: Record<string, number> = { High: 2, Medium: 1, Low: 0 };

const tabs = [
  { key: 'all', label: 'All bidders', n: bidders.length },
  { key: 'qualified', label: 'Qualified', n: n('qualified') },
  { key: 'awaiting', label: 'Awaiting decision', n: n('awaiting') },
  { key: 'review', label: 'In review', n: n('review') },
  { key: 'flagged', label: 'Flagged', n: n('flagged') },
];

const sortIcon = '<path d="M8 9.5 12 5.5l4 4"/><path d="M8 14.5 12 18.5l4-4"/>';
const downIcon = '<path d="M12 5.5v13M7.5 14 12 18.5 16.5 14"/>';
const riskColor = (r: string) =>
  r === 'High' ? 'color:var(--alert)' : r === 'Medium' ? 'color:var(--flag)' : 'color:var(--verify)';
---

<AppLayout
  title={`${tender.id} — Pramaan`}
  active="tenders"
  crumbs={[{ label: 'Tenders', href: `${base}app/tender` }, { label: tender.id }]}
>
  <div class="page-head">
    <div>
      <h1>{tender.title}</h1>
      <div class="meta-row">
        <span><b>{tender.id}</b></span>
        <span>{tender.value}</span>
        <span><b>{bidders.length}</b> bids · all verified</span>
        <span>mean score <b>{avg}</b></span>
        <span>Class-I preference</span>
        <span style="color:var(--flag);">closes in {tender.closes}</span>
      </div>
    </div>
    <div class="acts">
      <button class="btn-sm" type="button" data-ask="Which bidder should win this tender?">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m15.6 15.6 4.2 4.2"/></svg>
        Ask about this
      </button>
      <button class="btn-sm" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={downIcon}></svg>
        Export
      </button>
      <button class="btn-sm solid" type="button">Record decisions</button>
    </div>
  </div>

  <LiveAnalysis />

  <div class="tabs" data-ftabs="tbid" role="tablist" aria-label="Filter bidders">
    {tabs.map((t, i) => (
      <button
        class={`tab${i === 0 ? ' on' : ''}`}
        type="button"
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-filter={t.key}
      >
        {t.label} <span class="n">{t.n}</span>
      </button>
    ))}
    <span class="mono-cell num" data-fcount="tbid" style="margin-left:auto; padding-left:14px;">0 rows</span>
  </div>

  <div class="panel">
    <div class="toolbar">
      <div class="inline-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
        <input type="search" data-fsearch="tbid" placeholder="Bidder, city, MSME status…" aria-label="Filter bidders" />
      </div>
      <button class="chipf" type="button" data-fchip="tbid" data-term="Large enterprise">Large enterprise</button>
      <button class="chipf" type="button" data-fchip="tbid" data-term="MSME">MSME</button>
      <button class="chipf" type="button" data-fchip="tbid" data-term="High">Risk: High</button>
    </div>

    <div class="panel-body flush">
      <div class="tbl" id="tbid" data-ftable data-fper="8" data-fsort="score" style="min-width:800px;">
        <div class="tr th" style={`grid-template-columns:${cols};`}>
          <span class="selcell"><input type="checkbox" data-selall aria-label="Select all rows" /></span>
          <span>
            <button class="sortable" type="button" data-sort="name" data-dir="asc">
              Bidder
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={sortIcon}></svg>
            </button>
          </span>
          <span>
            <button class="sortable act" type="button" data-sort="score">
              Score
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={downIcon}></svg>
            </button>
          </span>
          <span>
            <button class="sortable" type="button" data-sort="risk">
              Risk
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={sortIcon}></svg>
            </button>
          </span>
          <span>
            <button class="sortable" type="button" data-sort="checks">
              Checks
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={sortIcon}></svg>
            </button>
          </span>
          <span>Status</span>
        </div>

        {bidders.map((b) => (
          <div
            class="tr row"
            style={`grid-template-columns:${cols};`}
            data-frow
            data-status={slug[b.status]}
            data-name={b.name}
            data-score={b.score}
            data-risk={riskRank[b.risk]}
            data-checks={b.checksPassed}
            data-text={`${b.name} ${b.city} ${b.entity} ${b.msme} ${b.risk} ${b.status}`.toLowerCase()}
          >
            <span class="selcell"><input type="checkbox" data-row aria-label={`Select ${b.name}`} /></span>
            <a href={`${base}app/bidder`} class="who" style="text-decoration:none; color:inherit;">
              <span class="av" aria-hidden="true">{b.ini}</span>
              <span class="t">
                <span class="n">{b.name}</span>
                <span class="s">{b.city} · {b.msme}</span>
              </span>
            </a>
            <span class="score-cell">
              <span class="v num">{b.score}</span>
              <span class={`bar ${b.tone === 'ok' ? '' : b.tone}`}><i style={`--w:${b.score}%`}></i></span>
            </span>
            <span class="mono-cell num" style={riskColor(b.risk)}>{b.risk}</span>
            <span class="mono-cell num">
              {b.checksPassed}/{b.checksTotal}
              {b.flags > 0 && <span style="color:var(--flag);"> ·{b.flags}</span>}
            </span>
            <span><span class={`bdg ${b.tone}`}>{b.status}</span></span>
          </div>
        ))}

        <div class="empty" data-fempty="tbid">
          <div class="t">No bidder matches that filter</div>
          <div class="d">Nothing on this tender matches the current tab and search.</div>
          <button class="btn-sm" type="button" data-freset="tbid">Clear filters</button>
        </div>
      </div>
    </div>

    <div class="pager">
      <span data-frange="tbid">Showing 0 of 0</span>
      <div class="pg">
        <button class="pgbtn" type="button" data-fprev="tbid" aria-label="Previous page">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <span class="mono-cell num" data-fpage="tbid" style="padding:0 4px;">1 / 1</span>
        <button class="pgbtn" type="button" data-fnext="tbid" aria-label="Next page">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var tbl = document.getElementById('tbid');
      if (!tbl) return;
      tbl.addEventListener('click', function (e) {
        if (e.target.closest('input, a, button')) return;
        var row = e.target.closest('.tr.row');
        if (!row) return;
        var link = row.querySelector('a.who');
        if (link) window.location.href = link.getAttribute('href');
      });
    })();
  </script>
</AppLayout>
