---
import AppLayout from '../../layouts/AppLayout.astro';
import LiveAnalysis from '../../components/LiveAnalysis.astro';
import { tender, focus, groups, findings, recommendation, documents, auditTrail } from '../../data/mock';

const base = import.meta.env.BASE_URL;

const logoFor: Record<string, string | null> = {
  'Udyam': 'udyam.png', 'GSTN': null, 'Income Tax': 'pan.png', 'MCA21': 'mca21.svg',
  'EPFO': 'epfo.png', 'ESIC': 'esic.png', 'Make in India': 'makeinindia.png',
  'BIS / DPIIT': 'makeinindia.png', 'Startup India': 'startup.png', 'NSIC': 'nsic.png',
  'DigiLocker': 'digilocker.png', 'GeM': 'gem.svg', 'Debarment': null, 'Uploaded': null,
};

const CIRC = 282.7;
const off = (CIRC - CIRC * (focus.score / 100)).toFixed(1);
const ringTone = focus.score >= 85 ? '' : focus.score >= 60 ? 'warn' : 'alert';

const warnIcon = '<path d="M12 8v5M12 16.2v.1"/><circle cx="12" cy="12" r="9"/>';
const infoIcon = '<circle cx="12" cy="12" r="9"/><path d="M12 16v-4.5M12 8.2v.1"/>';
const tick = '<path d="m5 13 4 4L19 7"/>';
const cross = '<path d="M7 7l10 10M17 7 7 17"/>';
const checkCount = groups.reduce((n, g) => n + g.checks.length, 0);
---

<AppLayout
  title={`${focus.name} — Trust Setu`}
  active="overview"
  crumbs={[
    { label: 'Queue', href: `${base}app` },
    { label: tender.id },
    { label: focus.seq },
  ]}
>
  <LiveAnalysis />

  <div class="panel" style="margin-bottom:14px;">
    <div class="record-head">
      <span class="avatar" aria-hidden="true">{focus.ini}</span>

      <div style="min-width:0;">
        <h1>{focus.name}</h1>
        <div class="meta-row">
          <span>{focus.entity}</span>
          <span>{focus.city}</span>
          <span>Inc. {focus.incorporated}</span>
          <span>{focus.turnover}</span>
        </div>
        <div style="margin-top:10px; display:flex; gap:7px; flex-wrap:wrap;">
          <span class="bdg warn">{focus.status}</span>
          <span class="bdg na">{focus.checksPassed}/{focus.checksTotal} checks</span>
          <span class="bdg na">08 Sep 09:14 IST</span>
        </div>
      </div>

      <div style="display:flex; align-items:center; gap:16px;">
        <div class={`ring ${ringTone}`} style={`--off:${off}`} role="img" aria-label={`Compliance score ${focus.score} out of 100, ${focus.risk} risk`}>
          <svg viewBox="0 0 104 104" aria-hidden="true">
            <circle class="track" cx="52" cy="52" r="45"/>
            <circle class="fill" cx="52" cy="52" r="45"/>
          </svg>
          <div class="val">{focus.score}<small>/100</small></div>
        </div>
        <div>
          <div style="font-family:var(--mono); font-size:9.5px; letter-spacing:.09em; text-transform:uppercase; color:var(--ink-muted);">Risk</div>
          <div style="font-family:var(--serif); font-size:20px; font-weight:600; color:var(--flag); margin-top:2px;">{focus.risk}</div>
        </div>
      </div>
    </div>

    <div class="id-strip">
      {focus.ids.map((i) => (
        <div class="cell">
          <div class="k">{i.k}</div>
          <div class="v">{i.v}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="grid-2">
    <div>
      <div class="tabs" id="tabs" role="tablist" aria-label="Bidder record sections">
        <button class="tab on" type="button" role="tab" id="tab-checks" aria-controls="pane-checks" aria-selected="true" tabindex="0" data-pane="checks">Checks <span class="n">{checkCount}</span></button>
        <button class="tab" type="button" role="tab" id="tab-findings" aria-controls="pane-findings" aria-selected="false" tabindex="-1" data-pane="findings">Findings <span class="n">{findings.length}</span></button>
        <button class="tab" type="button" role="tab" id="tab-docs" aria-controls="pane-docs" aria-selected="false" tabindex="-1" data-pane="docs">Documents <span class="n">{documents.length}</span></button>
        <button class="tab" type="button" role="tab" id="tab-trail" aria-controls="pane-trail" aria-selected="false" tabindex="-1" data-pane="trail">Trail <span class="n">{auditTrail.length}</span></button>
      </div>

      <!-- checks -->
      <div class="tabpane on" id="pane-checks" role="tabpanel" aria-labelledby="tab-checks" tabindex="0">
        <div class="panel">
          <div class="toolbar">
            <button class="chipf on" type="button">All <span class="x" aria-hidden="true">×</span></button>
            <button class="chipf" type="button">Discrepancies</button>
            <button class="chipf" type="button">Not applicable</button>
            <div class="tool-sep" aria-hidden="true"></div>
            <div class="inline-search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
              <input type="search" placeholder="Filter checks…" aria-label="Filter checks" />
            </div>
            <div class="tool-right">
              <span style="font-family:var(--mono); font-size:11px; color:var(--ink-muted);">{checkCount} checks · 12 sources</span>
            </div>
          </div>

          <div class="panel-body flush">
            {groups.map((g) => (
              <div class="grp">
                <div class="grp-head">
                  <span class="t">{g.title}</span>
                  <span class="n">{g.note}</span>
                </div>
                {g.checks.map((c) => (
                  <div class="chk">
                    <span class="src">
                      {logoFor[c.portal]
                        ? <img src={`${base}logos/${logoFor[c.portal]}`} alt="" loading="lazy" decoding="async" />
                        : <span style="width:18px; text-align:center;">·</span>}
                      {c.portal}
                    </span>
                    <span class="lbl">
                      {c.label}
                      <span class="ev">{c.evidence} · {c.ts}</span>
                    </span>
                    <span class="cmp">
                      <span class="sub">submitted: {c.submitted}</span>
                      <span class="got">{c.retrieved}</span>
                    </span>
                    <span class="st"><span class={`bdg ${c.verdict}`}>{c.state}</span></span>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- findings -->
      <div class="tabpane" id="pane-findings" role="tabpanel" aria-labelledby="tab-findings" tabindex="0">
        <div class="panel">
          <div class="panel-body flush">
            {findings.map((f) => (
              <div class={`find ${f.severity}`}>
                <span class="sev" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={f.severity === 'low' ? infoIcon : warnIcon}></svg>
                </span>
                <div>
                  <h4>
                    {f.title}
                    <span class={`bdg ${f.severity === 'high' ? 'alert' : f.severity === 'medium' ? 'warn' : 'info'}`}>
                      {f.severity === 'high' ? 'Blocking' : f.severity === 'medium' ? 'Curable' : 'Advisory'}
                    </span>
                  </h4>
                  <p>{f.detail}</p>
                  <div class="act">{f.action}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- documents -->
      <div class="tabpane" id="pane-docs" role="tabpanel" aria-labelledby="tab-docs" tabindex="0">
        <div class="panel">
          <div class="panel-body">
            <div class="docs">
              {documents.map((d) => (
                <div class="doc">
                  <div class="doc-h">
                    <div style="min-width:0;">
                      <div class="n">{d.name}</div>
                      <div class="m">{d.type} · {d.pages}p · {d.source}</div>
                    </div>
                    <span class={`bdg ${d.status}`}>{(d.confidence * 100).toFixed(0)}%</span>
                  </div>
                  <div class="doc-f">
                    {d.fields.map((f) => (
                      <div class="fld">
                        <span class="k">{f.k}</span>
                        <span class={`v ${f.match ? 'yes' : 'no'}`}>{f.v}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- trail -->
      <div class="tabpane" id="pane-trail" role="tabpanel" aria-labelledby="tab-trail" tabindex="0">
        <div class="panel">
          <div class="panel-body flush">
            <div class="trail">
              {auditTrail.map((a) => (
                <div class={`titem ${a.tone}`}>
                  <span class="ts">{a.ts}</span>
                  <span class="rail"><span class="dot"></span></span>
                  <div class="c">
                    <div class="ac">{a.action}<span class="by">{a.actor}</span></div>
                    <div class="dt">{a.detail}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- side rail -->
    <div class="col-side">
      <div class="stack">
        <div class="rec">
          <div class="rec-head">
            <span class="t">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5.9 1.2.9 1.9v.3h5.4v-.3c0-.7.3-1.4.9-1.9A6 6 0 0 0 12 3Z"/><path d="M9.8 19h4.4M10.5 21.5h3"/></svg>
              Recommendation
            </span>
            <span class="rec-conf">{(recommendation.confidence * 100).toFixed(0)}% confidence</span>
          </div>
          <div class="rec-body">
            <div class="rec-verdict">{recommendation.verdict}</div>
            <p class="rec-sum">{recommendation.summary}</p>

            <div class="rec-list pro">
              <h5>For</h5>
              <ul style="list-style:none; margin:0; padding:0;">
                {recommendation.for.map((r) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={tick}></svg>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="rec-list con" style="margin-top:14px;">
              <h5>Against</h5>
              <ul style="list-style:none; margin:0; padding:0;">
                {recommendation.against.map((r) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={cross}></svg>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="rec-caveat">
              Local content is self-declared and not independently audited. Portal data as at 09:14, 8 Sep 2026.
            </div>

            <div style="margin-top:14px; display:flex; gap:7px; flex-wrap:wrap;">
              <button class="chipf" type="button" style="background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.2); color:rgba(234,240,234,.86);" data-ask="Why is Nova Labtech flagged?">Why is this flagged?</button>
              <button class="chipf" type="button" style="background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.2); color:rgba(234,240,234,.86);" data-ask="What is clause 7.2?">What is clause 7.2?</button>
            </div>
          </div>
        </div>

        <div class="panel decide">
          <div class="panel-head">
            <h3>Decision</h3>
            <span class="note">{tender.id}</span>
          </div>
          <div class="panel-body">
            <label class="opt">
              <input type="radio" name="decision" />
              <span>
                <span class="t">Qualify</span>
                <span class="d">Proceed to technical evaluation.</span>
              </span>
            </label>
            <label class="opt">
              <input type="radio" name="decision" checked />
              <span>
                <span class="t">Seek clarification</span>
                <span class="d">Query the local content computation.</span>
              </span>
            </label>
            <label class="opt">
              <input type="radio" name="decision" />
              <span>
                <span class="t">Do not qualify</span>
                <span class="d">Record against clause 7.2.</span>
              </span>
            </label>

            <textarea class="note-box" placeholder="Reason for the record…">Seeking clarification on the local content computation before deciding on clause 7.2.</textarea>
          </div>
          <div class="decide-foot">
            <button class="btn-sm solid" type="button" id="recordBtn">Record decision</button>
            <button class="btn-sm" type="button">Save draft</button>
            <span class="saved" id="savedMsg">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              Recorded 
            </span>
            <span class="hint">as R. Nair</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var tabs = document.getElementById('tabs');
      if (tabs) {
        var btns = Array.prototype.slice.call(tabs.querySelectorAll('.tab'));

        function show(pane, focus) {
          btns.forEach(function (t) {
            var on = t.getAttribute('data-pane') === pane;
            t.classList.toggle('on', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            t.tabIndex = on ? 0 : -1;
            if (on && focus) t.focus();
          });
          document.querySelectorAll('.tabpane').forEach(function (p) {
            p.classList.toggle('on', p.id === 'pane-' + pane);
          });
          history.replaceState(null, '', '#' + pane);
        }

        tabs.addEventListener('click', function (e) {
          var btn = e.target.closest('.tab');
          if (btn) show(btn.getAttribute('data-pane'), false);
        });

        // arrow keys move between tabs, as a tablist should
        tabs.addEventListener('keydown', function (e) {
          var i = btns.indexOf(document.activeElement);
          if (i < 0) return;
          var next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1
                   : e.key === 'Home' ? 0 : e.key === 'End' ? btns.length - 1 : -1;
          if (next === -1) return;
          e.preventDefault();
          next = (next + btns.length) % btns.length;
          show(btns[next].getAttribute('data-pane'), true);
        });

        // survive a refresh or a back button
        var hash = (location.hash || '').replace('#', '');
        if (hash && document.getElementById('pane-' + hash)) show(hash, false);
      }

      // recording a decision should visibly do something
      var rec = document.getElementById('recordBtn');
      var msg = document.getElementById('savedMsg');
      if (rec && msg) {
        rec.addEventListener('click', function () {
          var choice = document.querySelector('input[name="decision"]:checked');
          var label = choice ? choice.closest('.opt').querySelector('.t').textContent.trim() : 'Decision';
          msg.lastChild.textContent = ' ' + label + ' recorded';
          msg.classList.add('on');
          setTimeout(function () { msg.classList.remove('on'); }, 4000);
        });
      }
    })();
  </script>
</AppLayout>
