# Optional local requirement-extraction model
LLM_ENABLED=false
REQUIREMENT_MODEL=qwen3:8b
DOCUMENT_CLASSIFIER_MODEL=phi3:mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=90

# Optional verification provider. Leave empty to keep values submitted_unverified.
# For the bundled synthetic demo provider use http://127.0.0.1:9000.
GOVERNMENT_API_URL=
GOVERNMENT_API_TIMEOUT_SECONDS=5

# Upload limits
MAX_TENDER_BYTES=26214400
MAX_BIDDER_ZIP_BYTES=52428800
MAX_SCENARIO_JSON_BYTES=5242880

# Extracted-content limits
MAX_ARCHIVE_ENTRIES=500
MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
MAX_ARCHIVE_MEMBER_BYTES=26214400
MAX_COMPRESSION_RATIO=200
MAX_NESTED_ZIP_DEPTH=3
MAX_PDF_PAGES=500
UPLOAD_CHUNK_BYTES=1048576
